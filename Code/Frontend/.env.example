# =============================================================================
# Frontend environment variables — template
# =============================================================================
# Copy to `.env` (gitignored) for local development. In production these are
# set in the Railway service environment, NOT in a committed file.
#
# NEXT_PUBLIC_* values are inlined at BUILD time and exposed to the browser.
# Never put a secret in a NEXT_PUBLIC_ var.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API base URL — read by src/lib/axios.ts and dashboard pages.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.ratereliefca.com

# -----------------------------------------------------------------------------
# Supabase (CRR dashboard auth + data) — read by src/lib/supabaseClient.ts
# and src/middleware.ts. The anon key is public by design (RLS enforces access).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# Google Maps Places API key — read by src/app/layout.tsx. Only loaded on the
# CRR host (ratereliefca.com) for the qualification-wizard address autocomplete.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your-google-places-api-key

# -----------------------------------------------------------------------------
# Google Analytics 4 measurement IDs — read by src/components/GoogleAnalytics.tsx
# -----------------------------------------------------------------------------
# This codebase serves 5 domains. Set a per-domain ID so each site reports into
# its own GA4 property (recommended — keeps reports clean). If you only set the
# legacy NEXT_PUBLIC_GA_MEASUREMENT_ID below, every domain shares that property.
#
# When ALL relevant vars are unset, GoogleAnalytics renders nothing → zero
# analytics + zero affiliate-click events are recorded on that domain.

NEXT_PUBLIC_GA_MEASUREMENT_ID_GLP1=G-XXXXXXXXXX   # glp1comparehub.com
NEXT_PUBLIC_GA_MEASUREMENT_ID_GRH=G-XXXXXXXXXX    # greenreviewshub.com
NEXT_PUBLIC_GA_MEASUREMENT_ID_SHG=G-XXXXXXXXXX    # securehomegear.com (when launched)
NEXT_PUBLIC_GA_MEASUREMENT_ID_AHB=G-XXXXXXXXXX    # athomebiohacking.com (when launched)
NEXT_PUBLIC_GA_MEASUREMENT_ID_CRR=G-XXXXXXXXXX    # ratereliefca.com

# Legacy single-property fallback. Used for any host that doesn't match the
# above list. Leave empty in production if all five per-domain IDs are set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Google Search Console verification tokens — read by src/app/layout.tsx
# -----------------------------------------------------------------------------
# Server-side only (no NEXT_PUBLIC_). The token is rendered into the page's
# <head> via generateMetadata() so Google's GSC scanner can find it.
#
# If you verify a GSC property via DNS TXT instead of HTML tag (recommended),
# leave these unset — DNS verification doesn't need a code change.

GSC_VERIFICATION_TOKEN_GLP1=
GSC_VERIFICATION_TOKEN_GRH=
GSC_VERIFICATION_TOKEN_SHG=
GSC_VERIFICATION_TOKEN_AHB=
GSC_VERIFICATION_TOKEN_CRR=
